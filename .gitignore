packaged.yaml

# Lambda invoke responses (labs scatter these — names vary per lab)
*.response.json
out.json
resp.json
/tmp/*.json

# Bundled Lambda dependencies (labs use `pip install -r src/requirements.txt -t src/`
# to bake packages into the deployment artifact; those installed dirs should not be committed.
# Every src/ in this repo is flat — only handler.py + requirements.txt — so ignoring
# subdirs is safe.)
**/src/*/
**/layer/python/*/

# Tooling
.python-version
*.tsbuildinfo
*.bak

# Logs
*.log
logs/

# Windows
Thumbs.db
ehthumbs.db
